{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lf-property-media",
  "compatibility_date": "2026-04-24",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  // NOTE: the live site deploys through the Cloudflare Pages *git* integration,
  // which does not read this file. Production bindings must be added to the
  // Pages project in the dashboard -- binding name DB, database lf-tours. This
  // block is what `wrangler d1 execute` and local dev use.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lf-tours",
      "database_id": "5c2d1f69-2cac-470f-bb4c-e455ad71a918"
    }
  ],

  // Panorama and floor-plan storage. Egress is free at any volume, which is the
  // whole reason for R2 here: every buyer who opens a tour pulls ~77 MB.
  // Same caveat as D1 -- the Pages git deployment needs this binding added to the
  // project in the dashboard as well, binding name MEDIA.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "lf-tour-media"
    }
  ]
}
